# Copy to .env.local (git-ignored) and fill in your values.

# true  → run entirely on seeded demo data (no Supabase needed)
# false → use the real Supabase backend below
VITE_USE_MOCK=true

# Supabase project settings (Project Settings → API).
# The anon key is public by design; never put the service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key

# Optional: verbose auth logging in production builds
# VITE_DEBUG_AUTH=true
